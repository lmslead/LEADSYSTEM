# Server Configuration
NODE_ENV=production
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/lms-system

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=https://olivialms.cloud

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Timezone
TZ=America/New_York

# GTI Integration
GTI_POSTBACK_URL=https://global-telecom-investors.trackdrive.com/api/v1/calls/update_call/[call_uuid]
GTI_AUTH_HEADER=Basic replace-with-token
GTI_TTL_DAYS=30

# Meta (Facebook/Instagram) Lead Ads Integration
META_VERIFY_TOKEN=your-meta-webhook-verify-token
META_APP_SECRET=your-meta-app-secret
META_PAGE_ACCESS_TOKEN=your-meta-page-access-token
META_GRAPH_API_VERSION=v19.0
META_DEFAULT_ORG_ID=
META_DEFAULT_USER_ID=

